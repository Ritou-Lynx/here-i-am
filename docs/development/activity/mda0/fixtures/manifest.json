      ]
    },
    {
      "file": "limits_and_atomicity.json",
      "cases": [
        "oversized_payload",
        "batch_atomic_rejection",
        "stale_epoch_or_fencing"
      ]
    }
  ],
  "mechanical_checks": [
    "parse_each_json_file",
    "match_manifest_case_names_exactly_once",
    "check_required_fixture_fields",
    "check_kind_and_coverage_against_ADR_dictionary",
    "check_expected_outcome_and_http_code_vocabularies",
    "check_normal_event_template_omits_event_id_and_batch_templates_do_too",
    "check_every_normal_event_has_pairing_capture_and_recipe",
    "check_wire_event_id_override_allowlist",
    "check_no_literal_bearer_credential_token_url_or_private_content",
    "check_credential_shaped_keys_and_values_against_symbolic_reference_allowlist",
    "check_sequence_creation_and_delivery_orders_and_gap_recovery",
    "fail_on_unused_fixture_fields_or_skipped_manifest_cases"
  ]
}
