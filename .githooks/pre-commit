#!/bin/sh

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/verify_project_state.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify_project_state.ps1
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_project_state.ps1
else
  echo "Project state check failed: PowerShell is required to run scripts/verify_project_state.ps1"
  exit 1
fi
